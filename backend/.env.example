# Example .env for backend — copy to .env and fill values
# Option A: single connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/football

# Option B: separate variables
#PGUSER=postgres
#PGPASSWORD=your_password
#PGHOST=localhost
#PGPORT=5432
#PGDATABASE=football

# Optional: backend port
#PORT=4000
